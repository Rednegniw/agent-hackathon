# Secrets - never commit (.env.example is the tracked template)
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Dependencies
node_modules/
.pnpm-store/

# pnpm is the only package manager here - never commit another lockfile
package-lock.json
yarn.lock
bun.lockb

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
runs/

# Rendered pitch videos, one directory per round. Regenerated every run, so
# they are noise — except for the round you demo from. Commit that one round's
# directory deliberately with `git add -f`, the same way runs/ works.
apps/arena/public/media/
