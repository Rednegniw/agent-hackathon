# Daytona API key - https://app.daytona.io
DAYTONA_API_KEY=

# Anthropic API key for the agent loop
ANTHROPIC_API_KEY=

# ElevenLabs - voiced pitch lines at submit time
ELEVENLABS_API_KEY=

# Braintrust - rounds logged as experiments, scorers grade each submission
# https://www.braintrust.dev/app/settings/api-keys
BRAINTRUST_API_KEY=
# Project the experiments land in (defaults to the arena project if unset)
BRAINTRUST_PROJECT=agent-hackathon-arena
