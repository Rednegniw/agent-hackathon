# Daytona API key - https://app.daytona.io
DAYTONA_API_KEY=

# Anthropic API key for the agent loop
ANTHROPIC_API_KEY=

# ElevenLabs - voiced pitch lines at submit time
ELEVENLABS_API_KEY=

# Braintrust - rounds logged as experiments, scorers grade each submission
# https://www.braintrust.dev/app/settings/api-keys
BRAINTRUST_API_KEY=
# Project the experiments land in (defaults to the arena project if unset)
BRAINTRUST_PROJECT=agent-hackathon-arena

# ---------------------------------------------------------------------------
# Round configuration. All optional; the defaults below are what runs if unset.
# ---------------------------------------------------------------------------

# The brief every agent answers. Broad on purpose: a narrow brief produces six
# variations of the same thing. Set TOPIC_ALPHA / TOPIC_BETA instead to give the
# two lanes different briefs.
# TOPIC=Build a cool, genuinely useful, minimalist website.

# Team size bounds. TEAM_MIN forces negotiation, TEAM_MAX stops everyone piling
# into one entry. Set both to 1 for a solo round.
# TEAM_MIN=2
# TEAM_MAX=3

# Divides every phase duration, for testing. 25 turns a ~14 minute round into ~34s.
# ROUND_SPEED=1

# The competitors' model, and the jurors' (kept separate so judging cost does
# not scale with agent quality).
# MODEL=claude-haiku-4-5
# JUDGE_MODEL=claude-haiku-4-5

# Keeps sandboxes alive past the round so preview URLs survive until the pitch.
# Required for the run you demo from. Reclaim with: pnpm --filter arena cleanup
# KEEP_ALIVE=1

# Skips the evaluator round entirely.
# SKIP_JUDGING=1
