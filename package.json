    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter arena smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rednegniw/agent-hackathon.git"
  },
  "bugs": {
    "url": "https://github.com/Rednegniw/agent-hackathon/issues"
  },
  "homepage": "https://github.com/Rednegniw/agent-hackathon#readme"
}
